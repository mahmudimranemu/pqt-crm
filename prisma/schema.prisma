  CONTACTED
  QUALIFIED
  VIEWING_ARRANGED
  VIEWED
  OFFER_MADE
  NEGOTIATING
  WON
  LOST
}

enum DealStage {
  RESERVATION
  DEPOSIT
  CONTRACT
  PAYMENT_PLAN
  TITLE_DEED
  COMPLETED
  CANCELLED
