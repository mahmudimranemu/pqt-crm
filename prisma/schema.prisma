  client  Client?  @relation(fields: [clientId], references: [id])
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([clientId])
  @@index([enquiryId])
  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

